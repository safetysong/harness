{
  "description": "하네스 공통 훅(플러그인용). 세트는 프로젝트의 .claude/harness.json 에서 고릅니다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" start",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook turn-start",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|SendUserFile|mcp__ccd_turn__wrap_up|mcp__ccd_session__.*|mcp__claude-code-remote__set_session_title",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook korean-guard pre",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__github__.*|.*add_repo",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook repo-guard",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook korean-guard post",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook mistake-log",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook stop-check",
            "timeout": 600,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "HARNESS_ROOT=\"${CLAUDE_PLUGIN_ROOT}\" bash \"${CLAUDE_PLUGIN_ROOT}/bootstrap/harness-sync.sh\" hook korean-guard stop",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
